# ---------------------------------------------------------------------------
# Discovery Transcriber v2 (ASR) — environment variables
# Copy to `.env` for local dev. On Render, set these in the dashboard.
# ---------------------------------------------------------------------------

# --- ASR provider (transcription) ---
# Set ONE key. If both are set, ASR_PROVIDER decides (default prefers Deepgram).
DEEPGRAM_API_KEY=your-deepgram-api-key
# SPEECHMATICS_API_KEY=your-speechmatics-api-key
# ASR_PROVIDER=deepgram        # or "speechmatics"
# DEEPGRAM_MODEL=nova-2
# ASR_LANGUAGE=en

# --- Claude (assigns real speaker names from context; verbatim-safe) ---
ANTHROPIC_API_KEY=your-anthropic-api-key
# CLAUDE_MODEL=claude-sonnet-4-6

# --- Gemini (ONLY used for video scene descriptions) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# Visual sampling: last VISUAL_CLIP_SECONDS of every VISUAL_INTERVAL_SECONDS.
VISUAL_INTERVAL_SECONDS=600
VISUAL_CLIP_SECONDS=10

# --- Google OAuth (same model as the Discovery Analyzer) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
# Must match the redirect URI registered on the OAuth client.
GOOGLE_REDIRECT_URI=https://discovery-transcriber-v2.onrender.com/auth/callback

PORT=3000
